node_modules/

# Build output.
dist/
dist/models/
release/
build/

# --- local-only / large assets (not pushed) ---

# Root-anchored on purpose: a bare `llm/` also matches `src/llm/`, which is
# tracked product code (the LLM client). Keep the slash prefix.
/llm/

# The 45 original Kurisu reaction clips are the author's own material. The iOS
# workflows fetch them at build time (curl from the Amadeus repo), so a clone
# still gets them; committing them here would redistribute them through the
# repository, which THIRD_PARTY_NOTICES forbids.
public/Resources/amadeus-voices/

# Capacitor iOS shell. Generated by `npx cap add ios` + `npx cap sync ios` inside
# the workflow; never a source artifact.
ios/
capacitor.config.json

# Local verification output (screenshots, logs).
preview/
*.log
