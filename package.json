{
  "name": "amadeus-pet",
  "version": "0.1.0",
  "description": "AMA-DEUS mobile client: Chinese conversation and subtitles, Makise Kurisu speaking Japanese from the 45 original clips or a local GPT-SoVITS server. Capacitor iOS shell over a shared web renderer.",
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "build:render": "vite build",
    "watch:render": "vite build --watch",
    "app": "electron .",
    "start": "npm run build:render && electron .",
    "pack": "npm run build:render && electron-builder --dir",
    "voices:fetch": "node tools/fetch-voices.mjs",
    "voices:verify": "node tools/fetch-voices.mjs --verify-only",
    "audit:src": "node tools/audit-reachability.mjs --quiet",
    "verify:contracts": "node tests/ios-runtime-contract.mjs && node tests/ios-ui-audio-contract.mjs && node tests/ios-sheet-reachability-contract.mjs && node tests/tts-transport-contract.mjs",
    "sync:reference-ui": "node scripts/sync-amadeus-ui.mjs"
  },
  "build": {
    "appId": "com.fan.amadeus-pet",
    "productName": "AMA-DEUS Pet",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES",
        "to": "THIRD_PARTY_NOTICES"
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility",
      "executableName": "amadeus-pet"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  }
}
