{
  "name": "amadeus-pet",
  "version": "0.1.0",
  "description": "AMA-DEUS — a Chinese-speaking desktop companion that answers in Chinese and speaks Japanese in Makise Kurisu's own voice, using bundled original clips with a local GPT-SoVITS fallback.",
  "main": "electron/main.cjs",
  "license": "MIT",
  "author": {
    "name": "rafiqxin",
    "url": "https://github.com/rafiqxin/amadeus-pet"
  },
  "scripts": {
    "build:render": "vite build",
    "watch:render": "vite build --watch",
    "app": "electron .",
    "start": "npm run build:render && electron .",
    "pack": "npm run build:render && electron-builder --dir",
    "dist": "npm run build:render && electron-builder",
    "dist:win": "npm run build:render && electron-builder --win",
    "icons": "python tools/make-icons.py",
    "voices:fetch": "node tools/fetch-voices.mjs",
    "verify:client": "node tools/verify-voice-client.mjs",
    "verify:chain": "node tools/verify-speech-chain.mjs"
  },
  "build": {
    "appId": "com.rafiqxin.amadeus",
    "productName": "AMA-DEUS",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES",
        "to": "THIRD_PARTY_NOTICES"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AMA-DEUS",
      "artifactName": "AMA-DEUS-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "AMA-DEUS-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Utility",
      "executableName": "amadeus-pet"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/core": "7.6.9",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  }
}
